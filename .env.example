# OneGodian App deployment environment
# Production domain: https://app.onegodian.com

NEXT_PUBLIC_APP_URL=https://app.onegodian.com
NEXT_PUBLIC_ORG_URL=https://onegodian.org
NEXT_PUBLIC_STORE_URL=https://onegodian.com
NEXT_PUBLIC_U_ONEGODIAN_URL=https://u.onegodian.com
NEXT_PUBLIC_GALAXY_URL=https://galaxy.onegodian.com
NEXT_PUBLIC_CAPITAL_URL=https://capital.onegodian.com
NEXT_PUBLIC_OMOS_URL=https://omos.onegodian.com
NEXT_PUBLIC_QUANTUMOHI_URL=https://quantumohi.com
NEXT_PUBLIC_QRV_URL=https://qrv.network
NEXT_PUBLIC_CONSOLE_URL=https://console.onegodian.com

# Auth/database/payment secrets stay empty in repo and must be configured in hosting.
NEXTAUTH_URL=https://app.onegodian.com
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bridge keys for plugin/node integrations. Never commit live values.
OMOS_MANIFEST_URL=https://omos.onegodian.com/api/manifest
CAPITAL_MANIFEST_URL=https://capital.onegodian.com/api/manifest
GALAXY_MANIFEST_URL=https://galaxy.onegodian.com/api/manifest
ONEGODIAN_PLATFORM_BRIDGE_KEY=
ONEGODIAN_CAPITAL_BRIDGE_KEY=
ONEGODIAN_GALAXY_BRIDGE_KEY=
QUANTUMOHI_PLATFORM_BRIDGE_KEY=
